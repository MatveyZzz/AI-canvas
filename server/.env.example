# AI Canvas server configuration — copy to server/.env and fill in.
# API keys live ONLY on the server; they are never sent to the browser.

# ---------- DeepSeek (default provider) ----------
# Get a key at https://platform.deepseek.com -> API Keys
DEEPSEEK_API_KEY=
# Optional: override endpoint (default https://api.deepseek.com, OpenAI-compatible)
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional: custom model list "id:Label:contextWindow,id2:Label2:128000"
# DEEPSEEK_MODELS=deepseek-chat:DeepSeek Chat (V3):128000,deepseek-reasoner:DeepSeek Reasoner (R1):128000

# ---------- OpenAI (optional fallback provider) ----------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODELS=gpt-4o-mini:GPT-4o mini:128000,gpt-4o:GPT-4o:128000

PORT=8787
DB_FILE=./data/ai-canvas.db
